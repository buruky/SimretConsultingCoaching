---
import BookingPanel from "./BookingPanel";
---

<section id="book" class="bg-sand-200/60 py-24 md:py-32">
  <div class="mx-auto max-w-4xl px-6 md:px-10">
    <div class="mb-12" data-reveal>
      <p class="mb-4 text-sm uppercase tracking-[0.2em] text-forest-700">Book a session</p>
      <h2 class="font-display text-3xl text-ink-900 md:text-4xl">
        Pick a session, pick a time.
      </h2>
    </div>

    <div data-reveal>
      <BookingPanel client:visible />
    </div>
  </div>
</section>
