---
// Asmara Art Deco motif: nested lozenge flanked by thin rules, inherits text color.
interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
---

<div class={`flex items-center justify-center gap-4 ${className}`} aria-hidden="true">
  <span class="h-px w-20 bg-current opacity-45"></span>
  <svg width="26" height="26" viewBox="0 0 20 20" fill="none" class="opacity-70 animate-pulse-soft">
    <path d="M10 2 L16 10 L10 18 L4 10 Z" stroke="currentColor" stroke-width="1.25"></path>
    <path d="M10 7 L12.5 10 L10 13 L7.5 10 Z" stroke="currentColor" stroke-width="1.25"></path>
  </svg>
  <span class="h-px w-20 bg-current opacity-45"></span>
</div>
