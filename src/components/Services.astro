---
import Divider from "./Divider.astro";

const services = [
  {
    name: "Premarital Coaching",
    who: "For engaged and newly-committed couples",
    length: "60 min · video",
    note: "Build a foundation before the wedding, not after.",
    bookable: true,
    // Must match an id in SESSION_TYPES in BookingPanel.tsx.
    bookingTab: "premarital",
  },
  {
    name: "Individual & Couples Coaching",
    who: "For individuals or couples, at any stage",
    length: "60 min · video",
    note: "One partner can book alone. The other doesn't need to attend.",
    bookable: true,
    bookingTab: "individual-couples",
  },
  {
    name: "Parenting Education & Coaching",
    who: "For parents and caregivers",
    length: "60 min · video",
    note: "Practical tools for raising children with connection and calm.",
    bookable: true,
    bookingTab: "parenting",
  },
  {
    name: "Bete Simret Weekend Workshop",
    who: "For married couples",
    length: "A full weekend",
    note: "In person, on scheduled dates. Look for upcoming workshop events.",
    bookable: true,
    bookingTab: "workshop",
  },
] as const;
---

<section id="services" class="bg-sand-100 py-24 md:py-32">
  <div class="mx-auto max-w-6xl px-6 md:px-10">
    <div class="mb-14 max-w-xl" data-reveal>
      <p class="mb-4 text-sm uppercase tracking-[0.2em] text-forest-700">Ways to work together</p>
      <h2 class="font-display text-3xl text-ink-900 md:text-4xl">
        Coaching for wherever you are in the relationship.
      </h2>
    </div>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-4">
      {
        services.map((s) => (
          <div
            data-reveal
            data-spotlight
            class="group flex flex-col justify-between rounded-2xl border border-ink-900/10 bg-sand-50 p-8 transition-all duration-300 hover:-translate-y-1.5 hover:border-forest-500/40 hover:shadow-xl hover:shadow-ink-900/5"
          >
            <div>
              <h3 class="font-display text-xl text-ink-900">{s.name}</h3>
              <p class="mt-2 text-sm text-ink-500">{s.who}</p>
              <p class="mt-6 text-sm text-ink-700">{s.length}</p>
              <p class="mt-4 text-sm text-ink-500">{s.note}</p>
            </div>
            <a
              href={s.bookable ? "#book" : "#contact"}
              data-book-tab={s.bookable ? s.bookingTab : undefined}
              class="mt-8 inline-flex w-fit items-center gap-2 text-sm font-medium text-ink-900 transition-colors group-hover:text-forest-700"
            >
              {s.bookable ? "Book this session" : "Get in touch"}
              <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
            </a>
          </div>
        ))
      }
    </div>

    <div
      data-reveal
      class="mt-6 flex flex-col items-start justify-between gap-4 rounded-2xl bg-ink-900 p-8 text-sand-100 md:flex-row md:items-center"
    >
      <div>
        <h3 class="font-display text-xl">Training &amp; consulting for organizations</h3>
        <p class="mt-2 max-w-lg text-sm text-sand-100/70">
          Motivational Interviewing, trauma, and collective trauma training
          for teams and organizations.
        </p>
      </div>
      <button
        type="button"
        data-cal-link="kebreab-yimesgen-nudzqr/training-consulting-inquiry"
        data-cal-config='{"layout":"month_view"}'
        class="whitespace-nowrap rounded-full bg-forest-500 px-6 py-3 text-sm text-sand-50 transition-all hover:bg-forest-600 active:scale-95"
      >
        Inquire about training
      </button>
    </div>

    <Divider class="mt-16 text-ink-500/60" />
  </div>
</section>

<script>
  // Loads Cal's embed so any [data-cal-link] button opens a booking popup.
  import { getCalApi } from "@calcom/embed-react";
  getCalApi();
</script>

<script>
  // "Book this session" links jump to #book, but the booking panel's tabs
  // (premarital / individual-couples / parenting / workshop) are separate
  // React state. Forward the clicked card's tab so BookingPanel can select
  // it: sessionStorage covers the case where the panel hasn't mounted yet
  // (client:visible), the custom event covers the case where it's already
  // on screen and mounted.
  document.querySelectorAll("[data-book-tab]").forEach((el) => {
    el.addEventListener("click", () => {
      const tab = el.getAttribute("data-book-tab");
      if (!tab) return;
      try {
        sessionStorage.setItem("bookingTab", tab);
      } catch {
        // sessionStorage unavailable (e.g. private mode) — the custom
        // event below still works if the panel is already mounted.
      }
      window.dispatchEvent(new CustomEvent("select-booking-tab", { detail: tab }));
    });
  });
</script>
