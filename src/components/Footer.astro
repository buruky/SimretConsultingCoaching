---
const year = new Date().getFullYear();
---

<footer id="contact" class="bg-ink-900 py-20 text-sand-100">
  <div class="mx-auto max-w-6xl px-6 md:px-10">
    <div class="flex flex-col items-start justify-between gap-10 border-b border-sand-100/10 pb-14 md:flex-row md:items-end">
      <div>
        <p class="font-display text-3xl">Simret Consulting &amp; Coaching</p>
        <p class="mt-3 max-w-sm text-sand-100/60">Connecting people. Inspiring change.</p>
      </div>
      <a
        href="#book"
        data-magnetic
        class="rounded-full bg-forest-500 px-7 py-3.5 text-sm text-sand-50 transition-colors hover:bg-forest-600"
      >
        Book a session
      </a>
    </div>

    <div class="flex flex-col gap-4 pt-8 text-sm text-sand-100/50 md:flex-row md:items-center md:justify-between">
      <p>© {year} Simret Consulting &amp; Coaching. All rights reserved.</p>
      <!-- TODO: swap in the client's real email/phone and social links once provided. -->
      <p class="text-sand-100/40">Video sessions, worldwide · In-person workshops on arrangement</p>
    </div>

    <p class="pt-6 text-xs text-sand-100/40">
      Site by
      <a
        href="https://burukyimesgen.com"
        target="_blank"
        rel="noopener nofollow"
        class="underline underline-offset-2 transition-colors hover:text-sand-100/70"
      >
        BK Web Studios
      </a>
    </p>
  </div>
</footer>
